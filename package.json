{
  "name": "mbgsec",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "bundle exec jekyll build",
    "format": "echo \"No formatting configured; skipping.\"",
    "test": "npm run validate:llm && npm run validate:talks && npm run validate:talk-enrichment && npm run test:talk-enrichment",
    "validate:llm": "node scripts/validate-llm-readiness.mjs",
    "validate:talks": "node scripts/validate-talk-resources.mjs",
    "validate:talk-enrichment": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs validate",
    "test:talk-enrichment": "node scripts/test-talk-enrichment.mjs",
    "talks:enrichment:inventory": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs inventory",
    "talks:enrichment:report": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs report",
    "talks:enrichment:queue": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs queue",
    "talks:enrichment:prepare": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs prepare-batch",
    "talks:abstracts:capture": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs capture-abstract --all --supported-only",
    "talks:abstracts:publish": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs publish-captured-abstracts",
    "talk:abstract:capture": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs capture-abstract",
    "talk:audio": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs fetch-audio",
    "talk:transcribe": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs transcribe",
    "talk:transcribe:local": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs transcribe-local",
    "talk:transcript:import-local": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs import-local-transcript",
    "talk:draft": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs draft",
    "talk:evaluate": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs evaluate",
    "talk:review-pack": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs review-pack",
    "talk:correct": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs apply-reviewed-corrections",
    "talk:review": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs review",
    "talk:publish-content": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs publish",
    "talks:transcripts:publish-approved": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs publish-approved --all",
    "talks:transcripts:remediate": "node .agents/skills/enrich-mbgsec-talks/scripts/enrich_talks.mjs remediate --all --continue-on-error",
    "lighthouse": "lhci autorun",
    "ci": "npm run build && npm run test",
    "deck:publish": "node scripts/publish-deck.mjs",
    "deck:upload": "op run --env-file=.env.op -- node scripts/publish-deck.mjs --upload"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbrg/mbgsec.git"
  },
  "keywords": [],
  "author": "",
